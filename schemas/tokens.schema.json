{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "commit",
    "tokens"
  ],
  "properties": {
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit",
          "usage",
          "theme",
          "origin",
          "source",
          "verification"
        ],
        "properties": {
          "source": {
            "$ref": "source.schema.json"
          },
          "origin": {
            "enum": [
              "original-definition",
              "analytical-summary"
            ]
          }
        }
      }
    }
  }
}
