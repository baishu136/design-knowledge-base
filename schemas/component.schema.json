{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "project",
    "purpose",
    "structure",
    "parameters",
    "states",
    "api",
    "behavior",
    "migration",
    "minimal_usage",
    "not_applicable",
    "sources",
    "verification",
    "runtime_verified",
    "license"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "runtime_verified": {
      "type": "boolean"
    }
  }
}
