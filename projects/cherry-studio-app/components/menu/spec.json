{
  "schema_version": "1.0",
  "id": "cherry-studio-app.component.menu",
  "name": "MenuContent / MenuPanel",
  "project": "cherry-studio-app",
  "purpose": "锚定操作、分组菜单及勾选项",
  "structure": "MenuOverlay→Animated外壳→MenuSurface→Animated内容→ScrollView→MenuRow",
  "parameters": "preferredWidth208、maxHeight480；初始32×32；padding2 gap.5；行图标size5",
  "states": "未测量、打开、关闭保留、卸载；关闭禁止pointerEvents/无障碍后代",
  "api": "anchor,isOpen,items,onClose,onClosed；MenuItem的checked/disabled/destructive及onPress",
  "behavior": "Android键盘变动关闭旧锚定菜单；layout高差>1才更新",
  "migration": "分离测量、定位、生命周期与渲染轨道；首次height=0时不启动",
  "minimal_usage": "<MenuContent anchor={anchor} isOpen={open} items={items} onClose={close} onClosed={afterClose} />",
  "not_applicable": "不受控的全屏内容或长列表里每项都加blur",
