{
  "schema_version": "1.0",
  "id": "droiddeck.component.color-picker",
  "name": "ColorPickerDialog",
  "project": "droiddeck",
  "purpose": "自定义渐变和True Black强调色",
  "structure": "AppDialog→旧新swatch→触摸色轮→三ValueSlider→hex→OK/Cancel",
  "parameters": "maxWidth460dp；色轮168dp；ColorCube44dp；Swatch48dp；hue0..360 step5，S/V0..100 step2",
  "states": "输入合法/非法、触摸调整、controller调整、确认/关闭",
  "api": "title,initial:Int,onDismiss,onApply(Int)；parseHex仅3/6位，可选#",
  "behavior": "非法hex禁用OK；色轮是触摸路径，滑杆/hex提供其他输入方式",
  "migration": "保留原始候选与确认应用分离；Palette校正可改变所见最终颜色，不将picker原值当最终主题值",
  "minimal_usage": "ColorPickerDialog(\"Primary\",initial,onDismiss={open=false},onApply={ save(it) })",
  "not_applicable": "需要alpha/8位hex的编辑器，原实现只支持不透明色",
