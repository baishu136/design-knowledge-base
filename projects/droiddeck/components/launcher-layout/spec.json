  "name": "LauncherLayout与AppScale",
  "project": "droiddeck",
  "purpose": "底部/侧边导航与用户界面缩放",
  "structure": "自定义Layout测navigation→1dp line→剩余内容，placeRelative支持方向",
  "parameters": "narrowScreen<600dp；NarrowPaneWidth520；AppScale选75/85/100/115/125/150%",
  "states": "bottomNavigation切向；宽高约束重算；scaled density和configuration同步",
  "api": "bottomNavigation,divider,navigation,content,modifier；scaledAppDensity/scaledAppConfiguration",
  "behavior": "dualScreen调用处可强制侧栏；不是仅由orientation或600自动决定",
  "migration": "迁移时保留字体缩放、导航占位与断点基准；勿单独scale绘制画面让命中框失配",
  "minimal_usage": "LauncherLayout(bottomNavigation=true,divider=pal.line,navigation={ Nav() },content={ Page() })",
  "not_applicable": "直接把Android Configuration dp当浏览器CSS px断点",
