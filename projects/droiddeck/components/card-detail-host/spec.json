  "migration": "稳定身份与可测量卡片原点优先，无法定位时必须有回退",
  "minimal_usage": "CardDetailHost(open,scroll,{false},{},grid={ Grid() },detail={ key -> Details(key) })",
  "not_applicable": "无限保留所有详情或跨Window原点未换坐标",
