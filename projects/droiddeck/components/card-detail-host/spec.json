  "id": "droiddeck.component.card-detail-host",
  "name": "CardDetailHost",
  "project": "droiddeck",
  "purpose": "从游戏grid进入详情且保留返回画面",
  "structure": "Offscreen渐隐Host→保留的grid Column→shown详情树→PageFlood",
  "parameters": "gridScale.95；fade顶部14dp；PAGE_RETURN_MS900基础窗口",
  "states": "open/shown/leaving/from；grid焦点在covering时拒绝enter",
